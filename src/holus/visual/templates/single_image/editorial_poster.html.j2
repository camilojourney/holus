{% extends "base.html.j2" %}

{% block body %}
<style>
  body {
    width: 1080px;
    height: 1350px;
    overflow: hidden;
  }

  .ig-editorial {
    box-sizing: border-box;
    width: 1080px;
    height: 1350px;
    position: relative;
    overflow: hidden;
    padding: 92px 76px 76px;
    background:
      radial-gradient(circle at 78% 14%, rgba(245, 158, 11, 0.16), transparent 28%),
      radial-gradient(circle at 12% 88%, rgba(99, 102, 241, 0.14), transparent 34%),
      #080d19;
    color: #f8fafc;
  }

  .ig-editorial.axis-center_stack {
    padding-left: 92px;
    padding-right: 92px;
  }

  .ig-editorial.axis-center_stack .ig-main {
    max-width: 860px;
    justify-self: center;
    text-align: center;
  }

  .ig-editorial.axis-center_stack .ig-subhook {
    margin-left: auto;
    margin-right: auto;
  }

  .ig-editorial.axis-center_stack .ig-proof {
    grid-template-columns: 1fr;
    gap: 32px;
    text-align: left;
  }

  .ig-editorial.axis-center_stack .ig-emphasis {
    text-align: center;
  }

  .ig-editorial.axis-split_weight {
    background:
      linear-gradient(90deg, rgba(245, 158, 11, 0.2), transparent 38%),
      radial-gradient(circle at 80% 18%, rgba(14, 165, 233, 0.14), transparent 30%),
      #080d19;
  }

  .ig-editorial.axis-split_weight .ig-main {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 48px;
    align-items: center;
    max-width: none;
  }

  .ig-editorial.axis-split_weight .ig-hook {
    font-size: 82px;
  }

  .ig-editorial.axis-split_weight .ig-subhook {
    max-width: 430px;
  }

  .ig-editorial.axis-split_weight .ig-proof {
    grid-template-columns: 1fr;
    gap: 28px;
    margin-top: 0;
  }

  .ig-editorial.density-medium .ig-proof {
    margin-top: 58px;
  }

  .ig-editorial.density-medium .ig-hook {
    font-size: 82px;
    line-height: 0.96;
  }

  .ig-editorial.density-medium .ig-subhook {
    font-size: 30px;
  }

  .ig-editorial::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.026) 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0.34;
    pointer-events: none;
  }

  .ig-editorial::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 10px;
    background: #f59e0b;
  }

  .ig-safe {
    position: relative;
    z-index: 1;
    height: 100%;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .ig-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--brand-font-secondary);
    font-size: 22px;
    color: #94a3b8;
  }

  .ig-kicker span:first-child {
    color: #f59e0b;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 800;
  }

  .ig-main {
    align-self: center;
    max-width: 900px;
  }

  .ig-hook {
    max-width: 910px;
    margin: 0 0 32px;
    font-size: 92px;
    line-height: 0.93;
    letter-spacing: 0;
    font-weight: 900;
    color: #f8fafc;
  }

  .ig-subhook {
    max-width: 760px;
    margin: 0;
    font-size: 34px;
    line-height: 1.28;
    color: #a8b3c7;
  }

  .ig-proof {
    display: grid;
    grid-template-columns: 0.7fr 1fr;
    gap: 44px;
    align-items: end;
    margin-top: 84px;
  }

  .ig-emphasis {
    font-size: 110px;
    line-height: 0.86;
    font-weight: 950;
    letter-spacing: 0;
    color: #f59e0b;
  }

  .ig-points {
    display: grid;
    gap: 18px;
    padding-bottom: 12px;
  }

  .ig-point {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 14px;
    align-items: start;
    font-size: 28px;
    line-height: 1.22;
    color: #e2e8f0;
  }

  .ig-point::before {
    content: "";
    width: 13px;
    height: 13px;
    margin-top: 10px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 0 7px rgba(245, 158, 11, 0.12);
  }

  .ig-footer {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 28px;
    padding-top: 28px;
    border-top: 1px solid rgba(148, 163, 184, 0.22);
  }

  .ig-punchline {
    max-width: 640px;
    font-size: 25px;
    line-height: 1.25;
    color: #cbd5e1;
  }

  .ig-author {
    text-align: right;
    font-family: var(--brand-font-secondary);
    font-size: 20px;
    color: #f59e0b;
    white-space: nowrap;
  }
</style>

<article class="ig-editorial axis-{{ composition_axis | default('left_anchor') }} density-{{ density | default('low') }}">
  <div class="ig-safe">
    <header class="ig-kicker">
      <span>{{ label | default("Prompt craft") }}</span>
      <span>{{ save_cue | default("Save this") }}</span>
    </header>

    <main class="ig-main">
      <h1 class="ig-hook">{{ hook | default(headline | default("Make it simple")) }}</h1>
      {% if subhook %}
      <p class="ig-subhook">{{ subhook }}</p>
      {% endif %}

      <section class="ig-proof">
        <div class="ig-emphasis">{{ emphasis_word | default("Focus") }}</div>
        <div class="ig-points">
          {% for point in proof_points %}
          <div class="ig-point">{{ point }}</div>
          {% endfor %}
        </div>
      </section>
    </main>

    <footer class="ig-footer">
      <div class="ig-punchline">{{ punchline | default("Less noise. More focus. Better output.") }}</div>
      {% if brand_handle %}
      <div class="ig-author">{{ brand_handle }}</div>
      {% endif %}
    </footer>
  </div>
</article>
{% endblock %}
