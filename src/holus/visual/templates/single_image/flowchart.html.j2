{% extends "base.html.j2" %}

{% block head %}
<style>
  body {
    margin: 0;
    font-family: "Inter", var(--brand-font-primary), sans-serif;
    background:
      radial-gradient(circle at top left, color-mix(in srgb, var(--brand-color-primary) 18%, transparent), transparent 36%),
      linear-gradient(180deg, #020617 0%, #0f172a 100%);
  }

  .flowchart-shell {
    width: var(--brand-image-width);
    height: var(--brand-image-height);
    padding: var(--brand-spacing-margin);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background:
      linear-gradient(180deg, rgba(15, 23, 42, 0.96) 0%, rgba(2, 6, 23, 0.98) 100%);
    position: relative;
    overflow: hidden;
  }

  .flowchart-shell::before {
    content: "";
    position: absolute;
    inset: 24px;
    border-radius: 36px;
    border: 1px solid color-mix(in srgb, var(--brand-color-primary) 28%, #1e293b);
    pointer-events: none;
  }

  .flowchart-title {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 820px;
    font-size: 48px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #f8fafc;
  }

  .flowchart-stage {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 32px 0;
  }

  .flowchart-stage svg {
    width: 100%;
    max-width: 860px;
    height: auto;
    filter: drop-shadow(0 16px 48px rgba(15, 23, 42, 0.4));
  }

  .flowchart-footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 20px;
    color: #94a3b8;
  }

  .flowchart-author {
    font-weight: 600;
    letter-spacing: 0.04em;
  }
</style>
{% endblock %}

{% block body %}
<div class="flowchart-shell">
  {% if title %}
  <h1 class="flowchart-title">{{ title }}</h1>
  {% endif %}

  <div class="flowchart-stage">
    {{ chart_svg | safe }}
  </div>

  <div class="flowchart-footer">
    {% if author_name %}
    <span class="flowchart-author">{{ author_name }}</span>
    {% endif %}
    {% if brand_handle %}
    <span>{{ brand_handle }}</span>
    {% endif %}
  </div>
</div>
{% endblock %}
