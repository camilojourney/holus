{% extends "base.html.j2" %}

{% block head %}
<style>
  body {
    margin: 0;
    font-family: "Inter", var(--brand-font-primary), sans-serif;
    background: #eef2f7;
  }

  .data-viz-shell {
    width: var(--brand-image-width);
    height: var(--brand-image-height);
    padding: 72px;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 40px;
    background:
      radial-gradient(circle at 85% 12%, rgba(20, 184, 166, 0.16), transparent 28%),
      linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%);
    position: relative;
    overflow: hidden;
  }

  .data-viz-kicker {
    margin: 0 0 18px;
    font-size: 22px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0f766e;
  }

  .data-viz-title {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 900px;
    font-size: 74px;
    line-height: 0.98;
    letter-spacing: 0;
    color: #0f172a;
  }

  .data-viz-stage {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 42px;
    border: 1px solid #dbe4ef;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 28px 70px rgba(15, 23, 42, 0.10);
  }

  .data-viz-stage svg {
    width: 100%;
    max-width: 920px;
    height: auto;
  }

  .data-viz-source {
    position: relative;
    z-index: 1;
    margin: 0;
    font-size: 20px;
    font-weight: 750;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #64748b;
  }
</style>
{% endblock %}

{% block body %}
<div class="data-viz-shell">
  <header>
    <p class="data-viz-kicker">Evidence</p>
    <h1 class="data-viz-title">{{ title }}</h1>
  </header>

  <div class="data-viz-stage">
    {{ svg_content | safe }}
  </div>

  {% if source_label %}
  <p class="data-viz-source">{{ source_label }}</p>
  {% endif %}
</div>
{% endblock %}
