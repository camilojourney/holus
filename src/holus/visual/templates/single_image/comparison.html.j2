{% extends "base.html.j2" %}

{% block head %}
<style>
  body {
    margin: 0;
    font-family: "Inter", var(--brand-font-primary), sans-serif;
    background: #eef2f7;
  }

  .compare-shell {
    width: var(--brand-image-width);
    height: var(--brand-image-height);
    padding: 68px;
    display: grid;
    grid-template-rows: auto auto auto;
    gap: 38px;
    background:
      radial-gradient(circle at 82% 16%, rgba(245, 158, 11, 0.18), transparent 27%),
      linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
    position: relative;
    overflow: hidden;
  }

  .compare-kicker {
    margin: 0 0 16px;
    font-size: 22px;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #b45309;
  }

  .compare-title {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 920px;
    font-size: 62px;
    line-height: 1;
    letter-spacing: 0;
    color: #111827;
  }

  .compare-stage {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 28px;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.88);
    box-shadow: 0 28px 70px rgba(15, 23, 42, 0.10);
  }

  .compare-stage svg {
    width: 100%;
    max-width: 980px;
    height: auto;
  }

  .compare-footer {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 20px;
    color: #64748b;
  }

  .compare-author {
    font-weight: 600;
    letter-spacing: 0.04em;
  }
</style>
{% endblock %}

{% block body %}
<div class="compare-shell layout-{{ html_layout | default('before_after_decision_table') }} mark-{{ mark_style | default('large_rows_with_clear_verdict') }}"
     data-surface-treatment="{{ surface_treatment | default('') }}"
     data-label-policy="{{ label_policy | default('') }}">
  {% if title %}
  <header>
    <p class="compare-kicker">Decision Surface</p>
    <h1 class="compare-title">{{ title }}</h1>
  </header>
  {% endif %}

  <div class="compare-stage">
    {{ chart_svg | safe }}
  </div>

  <div class="compare-footer">
    {% if author_name %}
    <span class="compare-author">{{ author_name }}</span>
    {% endif %}
    {% if brand_handle %}
    <span>{{ brand_handle }}</span>
    {% endif %}
  </div>
</div>
{% endblock %}
