{% extends "base.html.j2" %}

{% block body %}
<div class="slide-container slide-cta">
  <div class="slide-content">
    <h2 class="slide-cta-headline">{{ headline | default("Want more?") }}</h2>

    {% if body %}
    <p class="slide-cta-body">{{ body }}</p>
    {% endif %}

    {% if cta_text %}
    <div class="slide-cta-button">
      {{ cta_text }}
    </div>
    {% endif %}

    {% if handles %}
    <div class="slide-cta-handles">
      {% for handle in handles %}
      <span class="slide-cta-handle">{{ handle }}</span>
      {% endfor %}
    </div>
    {% endif %}
  </div>

  <div class="slide-footer">
    {% if author_name %}
    <span class="slide-author">{{ author_name }}</span>
    {% endif %}
    <span class="slide-counter">{{ slide_number | default(1) }} / {{ total_slides | default(1) }}</span>
  </div>
</div>
{% endblock %}
