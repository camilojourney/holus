{% extends "base.html.j2" %}

{% block head %}
<style>body { background-color: var(--brand-color-primary) !important; }</style>
{% endblock %}

{% block body %}
<div class="slide-container slide-hook {{ effect_class | default('') }}" {% if background_gradient %}style="background: {{ background_gradient | safe }};"{% endif %}>
  <div class="slide-content">
    {% if label %}
    <span class="slide-label">{{ label }}</span>
    {% endif %}

    <h1 class="slide-headline">{{ headline | default("Hook") }}</h1>

    {% if subheadline %}
    <p class="slide-subheadline">{{ subheadline }}</p>
    {% endif %}
  </div>

  <div class="slide-footer">
    {% if author_name %}
    <span class="slide-author">{{ author_name }}</span>
    {% endif %}
    <span class="slide-counter">{{ slide_number | default(1) }} / {{ total_slides | default(1) }}</span>
  </div>
</div>
{% endblock %}
