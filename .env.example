# ==============================================================================
# Holus Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env itself.
# ==============================================================================

# -- LLM Provider -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -- Trading (Alpaca) ---------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# -- Database ------------------------------------------------------------------
POSTGRES_URL=postgresql://holus:holus@localhost:5432/holus
POSTGRES_USER=holus
POSTGRES_PASSWORD=holus

# -- Redis (Event Bus + Kill Switch) ------------------------------------------
REDIS_URL=redis://localhost:6379

# -- Observability (Langfuse) -------------------------------------------------
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# -- Memory (Mem0) ------------------------------------------------------------
MEM0_API_URL=http://localhost:8080

# -- Workflow Automation (n8n) -------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678

# -- Content Distribution (Late) ----------------------------------------------
LATE_API_KEY=

# -- Image Generation (ComfyUI) -----------------------------------------------
COMFYUI_API_URL=http://localhost:8188

# -- Holus Application --------------------------------------------------------
HOLUS_ENV=development
HOLUS_LOG_LEVEL=INFO
HOLUS_KILL_SWITCH_KEY=holus:kill:global
