# ==============================================================================
# Holus Environment Variables
# Copy to .env and fill in actual values. NEVER commit .env itself.
# ==============================================================================

# -- LLM Provider -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -- Database ------------------------------------------------------------------
DATABASE_URL=postgresql://holus:holus@localhost:5432/holus
POSTGRES_USER=holus
POSTGRES_PASSWORD=holus

# -- Redis (Event Bus + Kill Switch) ------------------------------------------
REDIS_URL=redis://localhost:6379

# -- Observability (Langfuse) -------------------------------------------------
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# -- Memory (Mem0) ------------------------------------------------------------
MEM0_API_URL=http://localhost:8080

# -- Workflow Automation (n8n) -------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678

# -- Social Media (social-media-automatization MCP) ---------------------------
SOCIAL_MEDIA_API_BASE_URL=http://localhost:8000
POSTING_API_KEY=

# -- Pilaster (pilaster MCP — image generation) --------------------------------
PILASTER_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# -- Image Generation (ComfyUI) -----------------------------------------------
COMFYUI_API_URL=http://localhost:8188

# -- Local/dev Image Dispatcher ------------------------------------------------
# Enables the Holus VisualDispatcher codex_cli_image provider. Keep disabled in
# production; this shells out to the local Codex CLI for experimentation.
HOLUS_ENABLE_CODEX_IMAGE_PROVIDER=0

# -- Holus Application --------------------------------------------------------
HOLUS_ENV=development
HOLUS_LOG_LEVEL=INFO
# Local append-only provenance owner. Keep on private Holus storage.
HOLUS_LINEAGE_DIR=data/lineage
HOLUS_KILL_SWITCH_KEY=holus:kill:global
