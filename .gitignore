# ============================================================
# Holus .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# ---- Virtual Environment ----
.venv/
venv/
ENV/

# ---- Type Checking / Linting / Testing ----
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# ---- Environment / Secrets ----
.env
.env.local
.env.production
.env.*.local
# NOT .env.example -- that is committed as a template

# ---- Docker ----
docker-compose.override.yml

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Holus: Self-Improvement Reports ----
# Reports are agent-generated artifacts -- track .gitkeep only
.self-improvement/reports/**/*
!.self-improvement/reports/*/.gitkeep

# ---- Holus: Memory / Trajectory ----
# Trajectory logs are append-only runtime data, not source
.self-improvement/memory/trajectory*.jsonl
.self-improvement/memory/lessons.json

# ---- Holus: Agent Memory (runtime-accumulated) ----
.claude/agent-memory/**/*.jsonl

# ---- Holus: Audit Logs ----
.self-improvement/audit/

# ---- Data: Runtime ----
data/runtime/
data/content-queue/
data/lineage/
data/research/
data/test-runs/
data/.niche-research-state.json
data/.repurpose-state.json
*.db
*.sqlite3

# ---- Logs ----
logs/
*.log

# ---- Claude Code: Worktrees (ephemeral agent sandboxes) ----
.claude/worktrees/

# ---- Data: Generated Assets (runtime) ----
data/rendered/
data/examples/

# ---- Pipeline State (runtime) ----
.pipeline-state/

# ---- Health Check Artifacts ----
.failed

# ---- Evaluation Artifacts ----
.eval-artifacts/

# ---- Misc ----
*.bak
*.tmp
*.temp
.worktrees/
p2p3-final-review/

# graphify - commit graph.json; ignore generated reports/cache/viz outputs
graphify-out/.graphify_*
graphify-out/.rebuild.lock
graphify-out/cache/
graphify-out/hook-status.json
graphify-out/manifest.json
graphify-out/*.html
graphify-out/*.svg
graphify-out/*.graphml
graphify-out/wiki/
graphify-out/GRAPH_REPORT.md
graphify-out/cypher.txt
!graphify-out/graph.json
